# Copy to .env (git-ignored) and adjust. docker compose reads .env automatically.

# Model provider for requirement analysis: mock (default, no credentials) or anthropic
AI_PROVIDER=mock

# Required only when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Opt-in demo endpoint (POST /api/v1/demo/faults) used by scripts/demo.sh. Keep false outside demos.
DEMO_FAULT_INJECTION=true
